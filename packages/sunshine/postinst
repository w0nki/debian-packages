#!/bin/sh
# Same steps as upstream's postinst (src_assets/linux/misc/postinst), for a
# normal Debian install. Failures are reported but don't abort the install.
set -e

if [ "$1" = "configure" ]; then
  # Gamepad emulation needs the uhid module. /usr/lib/modules-load.d/60-sunshine.conf
  # loads it at every boot; load it now too so it works before a reboot.
  modprobe uhid 2>/dev/null || true

  # KMS screen capture needs CAP_SYS_ADMIN; CAP_SYS_NICE lets it raise its priority.
  # .deb files can't carry file capabilities, so they have to be set here.
  if command -v setcap >/dev/null; then
    setcap cap_sys_admin,cap_sys_nice+p /usr/bin/sunshine \
      || echo "sunshine: could not set capabilities; KMS capture won't work" >&2
  fi

  # Apply the udev rules (access to /dev/uinput and /dev/uhid) without a reboot.
  if command -v udevadm >/dev/null && [ -d /run/udev ]; then
    udevadm control --reload-rules || true
    udevadm trigger --property-match=DEVNAME=/dev/uinput || true
    udevadm trigger --property-match=DEVNAME=/dev/uhid || true
    udevadm trigger --subsystem-match=hidraw || true
    udevadm trigger --subsystem-match=input || true
  fi
fi

exit 0
